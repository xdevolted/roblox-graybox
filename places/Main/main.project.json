{
  "name": "RobloxGrayboxMain",
  "emitLegacyScripts": true,
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "../../src/shared"
      },
      "MainShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "../../src/server"
      },
      "MainServer": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Tests": {
        "$path": "../../tests"
      },
      "MainTests": {
        "$path": "tests"
      },
      "DevPackages": {
        "$path": "../../DevPackages"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "../../src/client"
        },
        "MainClient": {
          "$path": "src/client"
        }
      }
    }
  }
}
